NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Use a dedicated MySQL account with access only to ngo_surveys.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ngo_surveys
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=ngo_surveys
DB_SSL=false

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Required for password reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=NGO Surveys <no-reply@example.com>
