NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# For a separately hosted frontend, set its exact public origin on the backend.
FRONTEND_URL=
# Set true only when frontend and backend are on different sites (cross-site cookies).
CROSS_SITE_COOKIES=false
# Set this on the frontend build to the backend's public URL; leave blank for same-origin deployments.
VITE_API_BASE_URL=

# MongoDB connection string. Authentication is required even locally. The account is
# created inside its own database, so authSource points at that database and never at admin.
#   local:  mongodb://ngo_surveys:<password>@127.0.0.1:27017/ngo_surveys?authSource=ngo_surveys&authMechanism=SCRAM-SHA-256
#   hosted: mongodb+srv://ngo_surveys:<password>@<cluster>/ngo_surveys?authSource=ngo_surveys
MONGODB_URI=mongodb://127.0.0.1:27017/ngo_surveys
MONGODB_DB=ngo_surveys
# Set true when the database requires TLS (any hosted cluster).
DB_SSL=false

# Maintenance account used only by `npm run db:setup`. It can manage users but cannot
# read or write application data, and it is never used by the running application.
# Generate each password with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
MONGO_ADMIN_URI=mongodb://ngoSurveysAdmin:replace-me@127.0.0.1:27017/admin?authSource=admin&authMechanism=SCRAM-SHA-256
MONGO_ADMIN_USER=ngoSurveysAdmin
MONGO_ADMIN_PASSWORD=replace-with-a-long-random-password
MONGO_APP_USER=ngo_surveys
MONGO_APP_PASSWORD=replace-with-a-long-random-password

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Password reset email delivery (any SMTP provider). Values below are for Resend:
#   host smtp.resend.com, username "resend", password = your Resend API key (re_...).
#   Port 465/2465 use implicit TLS (SMTP_SECURE=true); 587/2587 use STARTTLS (SMTP_SECURE=false).
#   SMTP_FROM must be on a Resend-verified domain; onboarding@resend.dev is test-only.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM=NGO Surveys <onboarding@resend.dev>
