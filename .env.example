MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=ngo_surveys
DB_SSL=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional password reset email settings
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional separate frontend support
FRONTEND_URL=
CROSS_SITE_COOKIES=false
VITE_API_BASE_URL=
# One-time first administrator provisioning (set these only in your local .env)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
