# Backend (Render) — copy to .env and fill in real values. Keep .env out of source control.

# MongoDB connection. Atlas or a replica set. Must support transactions (replica set / sharded).
MONGODB_URI=mongodb+srv://ngo_surveys:CHANGE_ME@cluster.mongodb.net/ngo_surveys?replicaSet=rs0&serverSelectionTimeoutMS=10000

# Long random secret used to sign session cookies and reset tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the FRONTEND (Netlify), used to build password reset links as
# ${APP_URL}/?reset=<token>. Scheme + hostname, no path, no trailing slash.
APP_URL=https://your-netlify-site.netlify.app

# Exact frontend origin (scheme + hostname, no path, no trailing slash). The backend only
# echoes CORS headers for origins listed here. Comma-separated for multiple frontends.
FRONTEND_URL=https://your-netlify-site.netlify.app

# Set to "true" only when the frontend and backend are on different sites (Netlify + Render).
# Enables SameSite=None cookies so the session cookie survives the cross-site hop.
CROSS_SITE_COOKIES=true

# SMTP for password reset emails. Without these the app does not send reset links.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
SMTP_FROM=NGO Surveys <no-reply@example.com>

# Build-time: URL the frontend bundle calls the API from. Empty for same-origin (Render serves
# both). Set to the backend URL when the frontend is hosted separately (Netlify).
VITE_API_BASE_URL=https://ngo-surveys.onrender.com